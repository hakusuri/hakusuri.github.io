    <id>http://example.com/2026/10/06/%E7%AC%AC10%E8%AE%B2-PyTorch%E6%A2%AF%E5%BA%A6%E4%B8%8B%E9%99%8D%E5%AE%9E%E7%8E%B0%EF%BC%88%E5%AD%90%E7%AF%87%EF%BC%89/</id>
    <published>2026-10-06T10:10:50.000Z</published>
